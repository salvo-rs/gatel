# Everything a build does not read. Keeping `target/` out matters most: it is
# larger than the rest of the repository put together, and sending it would be
# sending a host's build products into a container build that cannot use them.
target/
.git/
.github/
docs/
*.md
!README.md
.gitignore
.dockerignore

# The benchmark's own containers, and the files it generates for them. The
# gateway image is built from this context, so the payloads would otherwise be
# uploaded to the daemon on every benchmark run.
benchmarks/
